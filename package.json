{
  "name": "pokemans",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "catalogue": "node supabase/scripts/catalogue/sync.mjs",
    "prices:map": "node supabase/scripts/buildPriceMap.mjs",
    "health": "node supabase/scripts/health.mjs",
    "test:regression": "node supabase/scripts/regression.mjs",
    "test:rls": "node supabase/tests/rls.mjs",
    "test:collection": "node supabase/tests/collection.mjs",
    "test:wants": "node supabase/tests/wants.mjs",
    "test:sync": "node supabase/tests/sync-prices.mjs",
    "test:merge": "node supabase/tests/merge-anonymous.mjs",
    "test:sweep": "node supabase/tests/sweep-anonymous.mjs",
    "test:supabase": "npm run test:regression && npm run test:rls && npm run test:collection && npm run test:wants && npm run test:sync && npm run test:merge && npm run test:sweep",
    "test": "npm test -w client && npm run test:supabase",
    "deploy": "npm run deploy -w client"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  }
}
