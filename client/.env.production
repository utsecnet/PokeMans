# Loaded by `vite build`, not by the dev server.
#
# One absolute URL serves both targets. From the web app it is same-origin, so the browser
# never performs a CORS check. From the Capacitor WebView, which loads from https://localhost,
# it is cross-origin — which is why the Worker sets the header on image responses itself.
#
# Dev deliberately has no value here: paths stay relative and Vite serves the ~23,000 files
# out of client/public, so local work needs no network and no bucket.
VITE_IMAGE_BASE_URL=https://pokemans.utsec.net/images

# Supabase. Both values are public by design: vite writes them into the javascript bundle at
# build time, so they ship to every visitor and are readable in devtools. Committing them
# changes nothing about who can see them -- it only means a build on a machine that is not
# this one produces a working bundle.
#
# Without them here, a CI build emits `undefined` for both and the site deploys clean, serves
# a 200, and shows a blank page. The build does not fail, which is what makes the omission
# worth closing before there is a pipeline rather than after.
#
# What protects the data is row level security tied to a signed-in user, not secrecy. Checked
# against a live anon client: collection_entries, want_list_entries, user_settings, user_roles
# and even tcg_cards all refuse it. The key alone reads nothing.
#
# The service role key is the opposite and lives in supabase/.env, gitignored, never committed.
# It bypasses row level security entirely and must never appear in this file.
VITE_SUPABASE_URL=https://xamyixuipbkyzssvxchc.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_TiNZYM6oAe6LM1wPJPc_NA_xGeyNzVj
